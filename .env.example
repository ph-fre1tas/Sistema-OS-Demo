# Banco PostgreSQL (ex.: Neon)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Chave secreta para assinatura de tokens JWT
JWT_SECRET=substitua_por_uma_chave_secreta_forte

# Ativa o modo demonstração somente leitura (true/false)
DEMO_MODE=true

# Opcional: credenciais SMTP (ignoradas automaticamente quando DEMO_MODE=true)
EMAIL_USER=
EMAIL_PASS=
